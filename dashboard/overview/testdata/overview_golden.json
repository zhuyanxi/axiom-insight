          "categories": [
            "database"
          ],
          "item_ids": [
            "dep:sql:orders"
          ],
          "plan_ids": [
            "m_sql_count"
          ],
          "expr": "(sum by (operation) (rate(sql_queries_total{service=\"payment\",status=~\"5[0-9]{2}|error\"}[$__rate_interval])) / sum by (operation) (rate(sql_queries_total{service=\"payment\"}[$__rate_interval])))",
          "legend_format": "{{operation}}"
        }
      ]
    },
    {
