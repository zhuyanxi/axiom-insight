            "cache"
          ],
          "item_ids": [
            "dep:redis:cache"
          ],
          "plan_ids": [
            "m_redis_count"
          ],
          "expr": "(sum by (operation) (rate(redis_commands_total{service=\"payment\",status=~\"5[0-9]{2}|error\"}[$__rate_interval])) / sum by (operation) (rate(redis_commands_total{service=\"payment\"}[$__rate_interval])))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "D",
          "kind": "error_ratio",
          "categories": [
            "rpc"
          ],
          "item_ids": [
            "ep:rpc:charge"
          ],
          "plan_ids": [
            "m_rpc_count"
          ],
          "expr": "(sum by (operation) (rate(rpc_requests_total{service=\"payment\",status=~\"5[0-9]{2}|error\"}[$__rate_interval])) / sum by (operation) (rate(rpc_requests_total{service=\"payment\"}[$__rate_interval])))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "E",
