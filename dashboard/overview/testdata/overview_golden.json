{
  "hash_version": "si-hash-v1",
  "service_name": "payment",
  "datasource_variable": {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0
  },
  "operation_variable": {
    "name": "operation",
    "type": "custom",
    "options": [
      {
        "text": "charge",
        "value": "charge"
      },
      {
        "text": "get",
        "value": "get"
      },
      {
        "text": "post",
        "value": "post"
      },
      {
        "text": "produce",
        "value": "produce"
      },
      {
        "text": "query",
        "value": "query"
      }
    ],
    "current": {
      "text": "charge",
      "value": "charge"
    },
    "multi": true,
    "include_all": true
  },
  "panels": [
    {
      "purpose": "requests_rate",
      "title": "Request Rate",
      "description": "Rate of handled operations per second across all dashboard categories sharing the same metric family.",
      "type": "stat",
      "width": 6,
      "height": 8,
      "unit": "ops/s",
      "no_value": "0",
      "targets": [
        {
          "ref_id": "A",
          "kind": "rate",
          "categories": [
            "http"
          ],
          "item_ids": [
            "ep:http:create_order",
            "ep:http:get_user"
          ],
          "plan_ids": [
            "m_http_count",
            "m_http_count2"
          ],
          "expr": "sum by (operation) (rate(http_requests_total{service=\"payment\"}[$__rate_interval]))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "B",
          "kind": "rate",
          "categories": [
            "kafka"
          ],
          "item_ids": [
            "dep:kafka:orders"
          ],
          "plan_ids": [
            "m_kafka_count"
          ],
          "expr": "sum by (operation) (rate(kafka_messages_total{service=\"payment\"}[$__rate_interval]))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "C",
          "kind": "rate",
          "categories": [
            "cache"
          ],
          "item_ids": [
            "dep:redis:cache"
          ],
          "plan_ids": [
            "m_redis_count"
          ],
          "expr": "sum by (operation) (rate(redis_commands_total{service=\"payment\"}[$__rate_interval]))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "D",
          "kind": "rate",
          "categories": [
            "rpc"
          ],
          "item_ids": [
            "ep:rpc:charge"
          ],
          "plan_ids": [
            "m_rpc_count"
          ],
          "expr": "sum by (operation) (rate(rpc_requests_total{service=\"payment\"}[$__rate_interval]))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "E",
          "kind": "rate",
          "categories": [
            "database"
          ],
          "item_ids": [
            "dep:sql:orders"
          ],
          "plan_ids": [
            "m_sql_count"
          ],
          "expr": "sum by (operation) (rate(sql_queries_total{service=\"payment\"}[$__rate_interval]))",
          "legend_format": "{{operation}}"
        }
      ]
    },
    {
      "purpose": "error_ratio",
      "title": "Error Ratio",
      "description": "Share of operations ending in the fixed error status pattern (5xx or error) across all metric families.",
      "type": "stat",
      "width": 6,
      "height": 8,
      "unit": "percent",
      "no_value": "0",
      "targets": [
        {
          "ref_id": "A",
          "kind": "error_ratio",
          "categories": [
            "http"
          ],
          "item_ids": [
            "ep:http:create_order",
            "ep:http:get_user"
          ],
          "plan_ids": [
            "m_http_count",
            "m_http_count2"
          ],
          "expr": "(sum by (operation) (rate(http_requests_total{service=\"payment\",status=~\"5[0-9]{2}|error\"}[$__rate_interval])) / sum by (operation) (rate(http_requests_total{service=\"payment\"}[$__rate_interval])))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "B",
          "kind": "error_ratio",
          "categories": [
            "kafka"
          ],
          "item_ids": [
            "dep:kafka:orders"
          ],
          "plan_ids": [
            "m_kafka_count"
          ],
          "expr": "(sum by (operation) (rate(kafka_messages_total{service=\"payment\",status=~\"5[0-9]{2}|error\"}[$__rate_interval])) / sum by (operation) (rate(kafka_messages_total{service=\"payment\"}[$__rate_interval])))",
          "legend_format": "{{operation}}"
        },
        {
          "ref_id": "C",
