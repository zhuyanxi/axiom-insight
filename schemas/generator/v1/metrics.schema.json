{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiom-insight.dev/schemas/generator/v1/metrics.schema.json",
  "title": "Axiom Insight metrics.yaml contract v1",
  "description": "Closed v1 contract of metrics.yaml. Unknown fields, wrong scalar types and unknown enums are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "source", "generated_by", "metrics"],
  "properties": {
    "schema_version": { "type": "string", "const": "generator.metrics/v1" },
    "document_type": { "type": "string", "const": "instrumentation.metrics" },
    "source": { "$ref": "#/$defs/source" },
    "generated_by": { "$ref": "#/$defs/generated_by" },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ir_schema_version", "service_name"],
      "properties": {
        "ir_schema_version": { "type": "string", "minLength": 1 },
        "service_name": { "type": "string", "minLength": 1 }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["endpoint", "function", "dependency", "call_edge"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "value_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["constant", "ir", "runtime_result", "runtime_resource", "runtime_context", "runtime_clock"]
        },
        "path": { "type": "string" },
        "string": { "type": "string" },
        "number": { "type": "number" },
        "bool": { "type": "boolean" },
        "allowed_values": {
          "type": "array",
          "items": { "type": "string", "enum": ["ok", "error", "cancelled", "timeout", "unknown"] }
        },
        "fallback": { "type": "string" },
        "required": { "type": "boolean" },
        "type": { "type": "string", "enum": ["string", "int", "double", "bool", "status", "timestamp", "number"] }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "binding"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["string", "int", "double", "bool", "status", "timestamp", "number"] },
        "binding": { "$ref": "#/$defs/value_binding" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "value"],
      "properties": {
        "trigger": { "type": "string", "enum": ["operation_start", "operation_end", "state_change"] },
        "value": { "$ref": "#/$defs/value_binding" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "unit", "target", "record"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["counter", "histogram", "gauge", "summary"] },
        "unit": { "type": "string" },
        "description": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "record": { "$ref": "#/$defs/record" },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "quantiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
        },
        "attributes": { "type": "array", "items": { "$ref": "#/$defs/attribute" } }
      }
    }
  }
}
